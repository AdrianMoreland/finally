{
  "name": "finally",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "figma:build": "node tools/figma-plugin/build.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:push": "pnpm --filter @finally/db db:push",
    "db:seed": "pnpm --filter @finally/db db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3"
  }
}
