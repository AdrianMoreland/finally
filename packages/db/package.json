{
  "name": "@finally/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx seed/index.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src seed",
    "test": "echo \"no tests\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.0",
    "@finally/finance-core": "workspace:*"
  },
  "devDependencies": {
    "@finally/config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "prisma": "^7.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
